# development: local CORS, API docs, and a random signing key if SECRET_KEY is blank.
# Leave APP_ENV unset in production, where safe settings are enforced.
APP_ENV=development

# Set to true on a demonstration copy, to show a Demo label holding made-up records.
DEMO_MODE=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SCHOOL_NAME=Al-Noor Academy
SCHOOL_TAGLINE=Excellence in Education & Character
SCHOOL_ADDRESS=Plot 42, Sector F-8/4, Islamabad, Pakistan
SCHOOL_PHONE=+92 (51) 285-4321
SCHOOL_EMAIL=info@alnoor-academy.edu.pk
CURRENCY=Rs.
SECRET_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: AI Admissions (CrewAI) endpoint. Without these, that one feature returns 503.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Admin password when the account is first created. Blank in development prints a one-time password.
ADMIN_PASSWORD=
# Exact frontend address, or several separated by commas. Required in production.
FRONTEND_URL=

# Password reset by email (teachers and parents). Development default: EMAIL_BACKEND=file writes each email to
# backend/dev_outbox/ as an .eml file and sends nothing. Production needs real SMTP, set only in the Modal secret:
# EMAIL_BACKEND=smtp  SMTP_HOST=...  SMTP_PORT=587  SMTP_USERNAME=...  SMTP_PASSWORD=...
# SMTP_SECURITY=starttls (or ssl, none)  EMAIL_FROM=no-reply@your-school.example
# PASSWORD_RESET_URL_BASE=https://your-frontend.example  (defaults to the first FRONTEND_URL)
# Hostinger Email: SMTP_HOST=smtp.hostinger.com, then either SMTP_PORT=465 with SMTP_SECURITY=ssl (recommended)
# or SMTP_PORT=587 with SMTP_SECURITY=starttls. SMTP_USERNAME is the full mailbox address, SMTP_PASSWORD is that
# mailbox's password, and EMAIL_FROM must be that same mailbox. Put the real values in the Modal secret or a
# git-ignored *.env file, never in this file. Staging check: python staging_reset_email_check.py
EMAIL_BACKEND=file
